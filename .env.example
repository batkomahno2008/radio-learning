# Copy this file to .env and change the password. Git ignores .env.
# `npm start` and `npm run dev` read .env. A variable that the shell sets has
# priority over the value in .env.

# Local Postgres. This command reads the three POSTGRES_ values from .env:
#   docker run -d --name radio-db --env-file .env -p 127.0.0.1:5432:5432 -v radio-db:/var/lib/postgresql postgres:18.6-alpine
POSTGRES_USER=radio
POSTGRES_DB=radio
# Change the password before you start Postgres or Compose. Use a random value, for
# example the output of `openssl rand -hex 24`, in POSTGRES_PASSWORD and DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Required. Use the same user, password and database as above. The app has no
# default and does not log this value.
DATABASE_URL=postgres://radio:change-me@127.0.0.1:5432/radio

# Optional. The lines below show the defaults.
# Address and port of the app. A container uses HOST=0.0.0.0.
# HOST=127.0.0.1
# PORT=3000
# Stream list, one stream on each line. For the E2E suite, use tests/fixtures/streams.txt.
# STREAMS_FILE=stream_URL.txt
# false: the app does not serve public/ and /vendor/hls, because NGINX serves them.
# SERVE_STATIC=true
# Express "trust proxy": false, true, a number of proxy hops, or a list of addresses.
# Deployments use 1 (one NGINX in front of the app).
# TRUST_PROXY=false

# Docker Compose (compose.yaml). Compose reads .env in the project directory.
# DATABASE_URL above is for `npm start` on the host. Compose builds the URL for the
# app from POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB. Use only URL-safe
# characters in POSTGRES_PASSWORD, for example the output of `openssl rand -hex 24`.
# Images. The defaults are the published images. For a local build, run
# `docker compose up --build`, or set the names of images that you built.
# APP_IMAGE=ghcr.io/batkomahno2008/radio-learning:latest
# PROXY_IMAGE=ghcr.io/batkomahno2008/radio-learning-proxy:latest
# Host ports of NGINX. These are the only published ports. HTTPS_PORT needs compose.tls.yaml.
# HTTP_PORT=80
# HTTPS_PORT=443
# Origins of the station host, for the CSP of NGINX (space-separated). Default: the real station.
# STATION_ORIGINS=https://d3d4yli4hf5bmh.cloudfront.net
# The stream list on the host. The app reads it again on each request.
# STREAMS_HOST_FILE=./stream_URL.txt
# TLS (compose.tls.yaml): the directory with fullchain.pem and privkey.pem. Keep it outside the repository.
# CERTS_DIR=/etc/radio-learning/certs
# Staging (compose.staging.yaml): the name of the stack.
# STAGING_ID=local
